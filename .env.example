# Nakili kuwa .env kisha badilisha
PORT=3000
# Folda ya database (ihifadhiwe/backup mara kwa mara)
DATA_DIR=./backend/data
# Weka 1 ukitumia Nginx/Cloudflare/cPanel proxy (HTTPS) ili IP halisi itumike kwa rate-limit
TRUST_PROXY=0
# Hiari: tovuti ikiwa kwenye domain tofauti na API, weka domain hiyo (mf. https://nialike.co.tz)
CORS_ORIGIN=
# --- Kutuma mialiko automatic ---
# Link ya tovuti yako (HTTPS) inayoingia kwenye mialiko, mf. https://nialike.co.tz
PUBLIC_URL=
# WhatsApp Business Cloud API (Meta) – template iliyoidhinishwa lazima iwe na vigezo 5 (angalia README)
WA_TOKEN=
WA_PHONE_ID=
WA_TEMPLATE=
WA_LANG=sw
# Webhook (hali: delivered/read): URL = https://domain/api/webhooks/whatsapp
WA_VERIFY_TOKEN=
WA_APP_SECRET=
# SMS mbadala (Beem Africa) – hutumika WhatsApp ikishindwa
BEEM_API_KEY=
BEEM_SECRET=
SMS_SENDER=
# Ujumbe kwa sekunde (default 5)
SEND_RATE=5
# Hiari: siri ya kusaini token (la sivyo itatengenezwa kwenye data/.secret)
NGT_SECRET=
